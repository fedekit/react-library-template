{
  "name": "mi-lib-react",
  "version": "0.1.0",
  "private": false,
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "sb": "storybook dev -p 6006",
    "sb:build": "storybook build",
    "docs:dev": "astro dev --root docs",
    "docs:build": "astro build --root docs",
    "docs:preview": "astro preview --root docs",
    "release": "echo 'usa release-please (GitHub Action)'"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.36.2",
    "@storybook/react": "10.0.3",
    "@storybook/react-vite": "10.0.3",
    "@swc/core": "1.14.0",
    "@swc/jest": "0.2.39",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.0",
    "@types/jest": "30.0.0",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.2",
    "astro": "^5.6.1",
    "jest": "30.2.0",
    "jest-environment-jsdom": "30.2.0",
    "sharp": "^0.34.2",
    "storybook": "10.0.3",
    "tsup": "8.5.0",
    "typescript": "5.9.3",
    "vite": "7.1.12"
  },
  "engines": {
    "node": ">=20.19.5"
  }
}
